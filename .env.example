# Copy this file to .env and fill in your key.
# .env is already gitignored, so your key never gets committed.

# Free API key from https://console.groq.com/keys
# Used ONLY as an automatic fallback if the local Ollama server is not running.
GROQ_API_KEY=your_groq_api_key_here

# Optional: which Groq-hosted model to use as the fallback (default shown below)
GROQ_MODEL=llama-3.1-8b-instant
